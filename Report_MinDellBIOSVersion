Select Top 1000000 
  tsysOS.Image As icon,
  tblAssets.AssetID,
  tblAssets.AssetName,
  tsysIPLocations.IPLocation As [IP Location],
  tblAssets.Username,
  tblAssetCustom.Manufacturer,
  tblAssetCustom.Model As Product,
  tblBIOS.SMBIOSBIOSVersion As [Current BIOS],

  -- Minimum BIOS (N/A if model not in Dell list)
  COALESCE(d.MinBIOS, 'N/A') As [Minimum BIOS for 2023 Cert],

  Case
    When d.MinBIOS Is Null Then 'N/A'
    When Try_Cast(PARSENAME(Replace(tblBIOS.SMBIOSBIOSVersion, 'A', ''), 3) As INT) > 
         Try_Cast(PARSENAME(d.MinBIOS, 3) As INT) 
      Or 
      (Try_Cast(PARSENAME(Replace(tblBIOS.SMBIOSBIOSVersion, 'A', ''), 3) As INT) = 
       Try_Cast(PARSENAME(d.MinBIOS, 3) As INT) And
       Try_Cast(PARSENAME(Replace(tblBIOS.SMBIOSBIOSVersion, 'A', ''), 2) As INT) > 
       Try_Cast(PARSENAME(d.MinBIOS, 2) As INT))
      Or 
      (Try_Cast(PARSENAME(Replace(tblBIOS.SMBIOSBIOSVersion, 'A', ''), 3) As INT) = 
       Try_Cast(PARSENAME(d.MinBIOS, 3) As INT) And
       Try_Cast(PARSENAME(Replace(tblBIOS.SMBIOSBIOSVersion, 'A', ''), 2) As INT) = 
       Try_Cast(PARSENAME(d.MinBIOS, 2) As INT) And
       IsNull(Try_Cast(PARSENAME(Replace(tblBIOS.SMBIOSBIOSVersion, 'A', ''), 1) As INT), 0) >= 
       IsNull(Try_Cast(PARSENAME(d.MinBIOS, 1) As INT), 0))
    Then 'GOOD'
    Else 'BAD - Update BIOS'
  End As [BIOS Status],

  tsysOS.OSname As OS,
  tblAssets.Lastseen As [Last Successful Scan]

From tblAssets
  Inner Join tblAssetCustom On tblAssetCustom.AssetID = tblAssets.AssetID
  Inner Join tblComputersystem On tblComputersystem.AssetID = tblAssets.AssetID
  Inner Join tsysOS On tblAssets.OScode = tsysOS.OScode
  Left Join tsysIPLocations On tsysIPLocations.LocationID = tblAssets.LocationID
